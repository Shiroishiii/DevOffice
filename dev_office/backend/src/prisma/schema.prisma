generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        Int                 @id @default(autoincrement())
  email     String              @unique
  nome      String
  senha     String
  ponto      Int                @default(0)
  planos_id Int
  planos    Planos @relation(fields: [planos_id], references: [id])
  empresa   EmpresasExistentes
  tarefas  UsuarioTarefa[]

  @@map("usuario")
}

model Tarefa {
  id              Int          @id @default(autoincrement())
  titulo          String
  descricao       String
  funcaoEsperada  String
  codigoBase      String       @db.Text
  ponto              Int          @default(50)
  testes          Teste[]
  tarefasUsuarios UsuarioTarefa[]
  dataVencimento  DateTime
  status          StatusTarefa @default(PENDENTE)

  @@map("tarefa")
}

model Teste {
  id        Int  @id @default(autoincrement())
  entrada   Json
  esperado  Json
  tarefaId  Int
  tarefa    Tarefa @relation(fields: [tarefaId], references: [id])
  @@map("teste")
}


model Planos {
  id        Int       @id @default(autoincrement())
  tipoPlano TipoPlano @default(Basico)
  usuarios  Usuario[]

  @@map("planos")
}

model UsuarioTarefa {
  id             Int       @id @default(autoincrement())

  usuarioId      Int
  tarefaId       Int

  concluida      Boolean   @default(false)
  dataConclusao  DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  tarefa  Tarefa  @relation(fields: [tarefaId], references: [id])

  @@unique([usuarioId, tarefaId])

  @@map("usuario_tarefa")
}
