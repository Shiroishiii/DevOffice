// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmpresaQuePertence {
  
  
}

enum Status{
  PENDENTE
  CONCLUIDO
}

model Usuario { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  nome  String?
  senha String

  @@map("usuario")
} 

model Empresa {
  id    Int      @id @default(autoincrement()) 
  nome String?   
  email String   @unique
  telefone Int   @unique
  CNPJ  Int      @unique

  @@map("empresa")
}

model Tarefa {
  id  Int   @id   @default(autoincrement())
  titulo    String
  descricao String
  data_vencimento   DateTime
  status    Status  @default(PENDENTE)


  @@map("tarefa")
}
