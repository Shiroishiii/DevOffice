// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusTarefa {
  PENDENTE
  CONCLUIDO
}

enum TipoPlano {
  Basico
  Standard
  Premium
}

model Usuario {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  nome      String?
  senha     String
  planos_id Int?
  planos    Planos?   @relation(fields: [planos_id], references: [id])
  empresas  Empresa[]

  @@map("usuario")
}

model Empresa {
  id         Int     @id @default(autoincrement())
  nome       String?
  email      String  @unique
  telefone   Int     @unique
  usuario_id Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id])

  @@map("empresa")
}

model Tarefa {
  id              Int          @id @default(autoincrement())

  titulo          String
  descricao       String

  funcaoEsperada  String

  codigoBase      String       @db.Text

  xp              Int          @default(50)

  testes          Teste[]

  dataVencimento  DateTime

  status          StatusTarefa @default(PENDENTE)
  usuario_id      Int?
  usuario         Usuario      @relation(fields: [usuario_id], references: [id])

  @@map("tarefa")
}

model Teste {
  id        Int  @id @default(autoincrement())

  entrada   Json
  esperado  Json

  tarefaId  Int
  tarefa    Tarefa @relation(fields: [tarefaId], references: [id])

  @@map("teste")
}

model Planos {
  id        Int       @id @default(autoincrement())
  tipoPlano TipoPlano @default(Basico)
  usuarios  Usuario[]

  @@map("planos")
}
