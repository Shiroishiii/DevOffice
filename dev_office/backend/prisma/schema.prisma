generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  nome      String?
  senha     String
  planos_id Int?
  empresa   EmpresasExistentes
  tarefas   Tarefa[]
  planos    Planos?            @relation(fields: [planos_id], references: [id])

  @@map("usuario")
}

model Tarefa {
  id             Int          @id @default(autoincrement())
  titulo         String
  descricao      String
  status         StatusTarefa @default(PENDENTE)
  codigoBase     String
  dataVencimento DateTime
  funcaoEsperada String
  usuario_id     Int?
  xp             Int          @default(50)
  usuario        Usuario?     @relation(fields: [usuario_id], references: [id])
  testes         Teste[]

  @@map("tarefa")
}

model Teste {
  id       Int    @id @default(autoincrement())
  entrada  Json
  esperado Json
  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id])

  @@map("teste")
}

model Planos {
  id        Int       @id @default(autoincrement())
  tipoPlano TipoPlano @default(Basico)
  usuarios  Usuario[]

  @@map("planos")
}

enum StatusTarefa {
  PENDENTE
  CONCLUIDO
}

enum TipoPlano {
  Basico
  Standard
  Premium
}

enum EmpresasExistentes {
  HardCode
  gamingColdest
  GreeCode
}
